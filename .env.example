# =====================================================================
#  MFsquare – Beispiel-Einstellungen
#  Bei Portainer trägst du diese Werte bequem im Stack unter
#  "Environment variables" ein. Lokal: Datei nach ".env" kopieren.
#  Nicht gesetzte Werte nutzen die Defaults aus docker-compose.yml.
# =====================================================================

# --- Domains ---
DOMAIN=mfsquare.ch
DASHBOARD_HOST=network.mfsquare.ch
AUTH_HOST=auth.mfsquare.ch

# --- Login-Benutzer ---
ADMIN_USER=admin
ADMIN_DISPLAYNAME=MF Admin
ADMIN_EMAIL=admin@mfsquare.ch

# Passwort als Argon2-Hash erzeugen:
#   docker run --rm authelia/authelia:4.39 \
#     authelia crypto hash generate argon2 --password 'DEIN-PASSWORT'
# Hinweis: In DIESER .env-Datei die $-Zeichen NICHT verdoppeln.
# In Portainers Env-Feld ebenfalls den Hash 1:1 einfügen.
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$OudmYtq3EvI8V060d1JkJQ$il7pufDDFuDNWWg08ddlC2/4GRxA3CNc71DjujIewng

# --- Secrets (eigene erzeugen: docker run --rm authelia/authelia:4.39 authelia crypto rand --length 64) ---
SESSION_SECRET=4ec50574dc1d3c9d8c0a978d5ebc0820e73d5e8cbc5600538406da05c839dcda
JWT_SECRET=203e7068a6fafd4a3816cda19b582eb2e5c0409de9a147f94397a3c2427c18e4
STORAGE_ENCRYPTION_KEY=d21435d4e857c63b67ffed360c6e2fac9aef92688406b044e39d53214f94ae02

# --- Sitzung / Logging ---
SESSION_EXPIRATION=1 hour
SESSION_INACTIVITY=15 minutes
LOG_LEVEL=info

# --- Gateway-Port auf Server B (192.168.196.202) ---
# NPM läuft auf einem anderen Server (192.168.196.190) und erreicht dieses
# Gateway per LAN über  http://192.168.196.202:8082
GATEWAY_PORT=8082
