# Host-Port, unter dem der Container auf Server B lauscht.
# NPM (Server A) zeigt auf 192.168.196.202:<WEB_PORT>.
WEB_PORT=8085

# Ablageort der Dateien auf Server B (Volume). Darunter wird "web/" genutzt:
#   <DATA_DIR>/web/services.yaml   <- hier bearbeitest du die Dienste
#   <DATA_DIR>/web/bilder/         <- hier legst du Bilder ab
#   <DATA_DIR>/web/index.html      <- wird bei jedem Deploy aktualisiert
DATA_DIR=/home/maran/serverdata/server/network_dashboard
